#include <dt-bindings/zmk/matrix_transform.h>

#include "rommana_ffc-layouts.dtsi"

/ {
    chosen {
        zmk,kscan = &default_kscan;
        zmk,physical-layout = &rommana_30_layout;
    };

    default_kscan: kscan_0 {
        compatible = "zmk,kscan-gpio-matrix";
        diode-direction = "col2row";
        wakeup-source;
    };

    thirty_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <10>;
        rows = <3>;
        map = <
            RC(0,4) RC(0,3) RC(0,2) RC(0,1) RC(0,0)   RC(0,5) RC(0,6) RC(0,7) RC(0,8) RC(0,9)
            RC(1,4) RC(1,3) RC(1,2) RC(1,1) RC(1,0)   RC(1,5) RC(1,6) RC(1,7) RC(1,8) RC(1,9)
                    RC(2,3) RC(2,2) RC(2,1)                   RC(2,6) RC(2,7) RC(2,8)
                                    RC(2,4) RC(2,0)   RC(2,5) RC(2,9)
        >;
    };
};

&rommana_30_layout {
    transform = <&thirty_transform>;
};
